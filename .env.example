# --- LLM provider ---
# OpenRouter (https://openrouter.ai/keys) or NVIDIA build.nvidia.com (OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_FAST=openrouter/free
LLM_MODEL_CREATIVE=openrouter/free

# --- Data sourcing ---
APIFY_API_TOKEN=your-apify-api-token
APIFY_META_ADS_ACTOR_ID=apify/facebook-ads-scraper
TAVILY_API_KEY=your-tavily-api-key
EXA_API_KEY=your-exa-api-key

# --- Target ---
TARGET_DOMAIN=crowdwisdomtrading.com
TARGET_PRODUCT=algorithmic trading signals
TARGET_NICHE=retail day traders

# --- Video rendering ---
OPENMONTAGE_REPO_PATH=../OpenMontage
VIDEO_OUTPUT_DIR=outputs
